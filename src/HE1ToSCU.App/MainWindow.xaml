<Window x:Class="HE1ToSCU.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HE1 → SCU Character Converter" Width="1060" Height="870" MinWidth="820" MinHeight="720" Background="#10151E" Foreground="#E9EEF5" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#1A2432"/><Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="BorderBrush" Value="#354154"/><Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#25364B"/><Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="Padding" Value="15,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#121C29"/><Setter Property="Foreground" Value="#DCE7F5"/><Setter Property="BorderBrush" Value="#354154"/><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <Grid Margin="28,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="HE1 → SCU" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="CHARACTER CONVERTER" Foreground="#79B9EF" FontSize="11" FontWeight="SemiBold" Margin="2,3,0,9"/>
            <TextBlock Text="Models, skeletons and quaternion animation tracks for Acorn / Godot 3.1.2." Foreground="#A4B3C8"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#17202D" CornerRadius="9" Padding="20,14" Margin="0,0,0,18">
            <Grid x:Name="Inputs">
                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="114"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Source folder" VerticalAlignment="Center"/>
                <TextBox x:Name="SourceFolder" Grid.Column="1" Margin="0,3,10,3" KeyDown="SourceFolderKeyDown" ToolTip="Folder containing extracted HE1 .model and .hkx assets. Press Enter to scan."/>
                <Button Content="Folder…" Grid.Column="2" Margin="0,3" Click="BrowseSource"/>
                <TextBlock Text="HE1 model" Grid.Row="1" VerticalAlignment="Center"/>
                <ComboBox x:Name="Models" Grid.Row="1" Grid.Column="1" Margin="0,3,10,3" Padding="8" DisplayMemberPath="Name" SelectionChanged="ModelChanged" ToolTip="Choose a .model in the source folder"/>
                <Button Content="File…" Grid.Row="1" Grid.Column="2" Margin="0,3" Click="BrowseModel"/>
                <TextBlock Text="Skeleton .hkx" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox x:Name="SkeletonPath" Grid.Row="2" Grid.Column="1" Margin="0,3,10,3" ToolTip="Matching .skl.hkx; required when exporting animations"/>
                <Button Content="File…" Grid.Row="2" Grid.Column="2" Margin="0,3" Click="BrowseSkeleton"/>
                <TextBlock Text="Animations" Grid.Row="3" Margin="0,12,0,0"/>
                <ListBox x:Name="Animations" Grid.Row="3" Grid.Column="1" Margin="0,7,10,7" DisplayMemberPath="Name" SelectionMode="Extended"/>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,7"><Button Content="Add…" Click="AddAnimations"/><Button Content="Remove" Click="RemoveAnimations" Margin="0,7,0,0"/></StackPanel>
                <TextBlock Text="Export folder" Grid.Row="4" VerticalAlignment="Center"/>
                <TextBox x:Name="OutputPath" Grid.Row="4" Grid.Column="1" Margin="0,3,10,3" ToolTip="New export directory. Existing directories are preserved."/>
                <Button Content="Folder…" Grid.Row="4" Grid.Column="2" Margin="0,3" Click="BrowseOutput"/>
                <TextBlock Text="Acorn editor" Grid.Row="5" VerticalAlignment="Center"/>
                <TextBox x:Name="EditorPath" Grid.Row="5" Grid.Column="1" Margin="0,3,10,3" ToolTip="Optional. Uses Acorn to validate and write .scn, .mesh and .anim. Leave blank for text resources."/>
                <Button Content="File…" Grid.Row="5" Grid.Column="2" Margin="0,3" Click="BrowseEditor"/>
                <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#A4B3C8" FontSize="12" Text="Scale and coordinates are handled automatically. HE1 textures and parameters are adapted to SpatialMaterial. Export preserves the HE1 rig; SCU player retargeting is a separate step."/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" MinHeight="130">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,9"><TextBlock Text="CONVERSION LOG" Foreground="#A4B3C8" FontSize="11" FontWeight="SemiBold"/><Button Content="Save log…" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10,3" MinHeight="25" FontSize="11" Click="SaveLog"/></DockPanel>
            <TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" VerticalContentAlignment="Top" Background="#0B111A" Foreground="#B9CCE2" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,18,0"><TextBlock x:Name="Status" Text="Ready to convert" FontSize="12" Foreground="#A4B3C8" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/><ProgressBar x:Name="Progress" Height="5" Background="#25364B" Foreground="#50B4F7" BorderThickness="0" Maximum="100"/></StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Margin="0,0,10,0" IsEnabled="False" Click="Cancel"/>
            <Button x:Name="ConvertButton" Grid.Column="2" Content="Convert character" Background="#147DD1" FontWeight="SemiBold" Click="Convert"/>
        </Grid>
    </Grid>
</Window>
